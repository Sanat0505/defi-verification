# Application services
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-me
GROQ_API_KEY=replace-me
LLM_MODEL=openai/gpt-oss-20b

# Ethereum Sepolia (chain ID 11155111)
SEPOLIA_RPC=https://eth-sepolia.g.alchemy.com/v2/replace-me
# Required to discover every Mainnet Uniswap V3 pool. If omitted, coverage is
# explicitly marked incomplete and only curated demonstration pools are loaded.
MAINNET_RPC=https://eth-mainnet.g.alchemy.com/v2/replace-me

# ERC-4337 / ZeroDev
ZERODEV_PROJECT_ID=replace-me
# Optional: override the URL derived from ZERODEV_PROJECT_ID
# ZERODEV_RPC=https://rpc.zerodev.app/api/v3/replace-me/chain/11155111
PRIVATE_KEY=0xreplace-me

# Default when the user omits slippage (100 basis points = 1%). Allowed: 1-500.
# Explicit user limits are validated and frozen with the verification capability.
SWAP_SLIPPAGE_BPS=100

# Verification and state policy
SUPPORTED_CHAIN_ID=11155111
SUPPORTED_NETWORK=Ethereum Sepolia
KNOWLEDGE_MAX_AGE_HOURS=168
VERIFICATION_TTL_SECONDS=600
CONVERSATION_TTL_SECONDS=1800
API_TIMEOUT_SECONDS=45
LOG_LEVEL=INFO

# Optional loader tuning
# UNISWAP_LOG_CHUNK_SIZE=50000
