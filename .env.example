# Application services
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-me
GROQ_API_KEY=replace-me

# Ethereum Sepolia (chain ID 11155111)
SEPOLIA_RPC=https://eth-sepolia.g.alchemy.com/v2/replace-me
# Optional but required to discover every Mainnet Uniswap V3 pool.
# Without it, the v2 graph loads official Mainnet contracts, all Aave reserves,
# and a small curated set of real Uniswap pools.
MAINNET_RPC=https://eth-mainnet.g.alchemy.com/v2/replace-me

# ERC-4337 / ZeroDev
ZERODEV_PROJECT_ID=replace-me
# Optional: override the URL derived from ZERODEV_PROJECT_ID
# ZERODEV_RPC=https://rpc.zerodev.app/api/v3/replace-me/chain/11155111
PRIVATE_KEY=0xreplace-me

# Uniswap exact-input protection (100 basis points = 1%). Allowed: 1-500.
SWAP_SLIPPAGE_BPS=100

# Optional loader tuning
# UNISWAP_V3_START_BLOCK=11124455
# UNISWAP_LOG_CHUNK_SIZE=50000
