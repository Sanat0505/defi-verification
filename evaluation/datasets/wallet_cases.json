      "id": "W01",
      "category": "destination_policy",
      "mode": "wallet_policy",
      "whitelist_state": "allowed",
      "input": {"kind": "session", "to": "0x1111111111111111111111111111111111111111", "value_eth": 0},
      "expected_outcome": "PASS",
      "expected_reason_code": "DESTINATION_ALLOWED"
    },
    {
      "id": "W02",
      "category": "destination_policy",
      "mode": "wallet_policy",
      "whitelist_state": "missing",
      "input": {"kind": "session", "to": "0x1111111111111111111111111111111111111111", "value_eth": 0},
      "expected_outcome": "BLOCKED",
      "expected_reason_code": "DESTINATION_NOT_ALLOWED"
    },
    {
      "id": "W03",
      "category": "destination_policy",
      "mode": "wallet_policy",
